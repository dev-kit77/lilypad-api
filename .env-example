#Enviroment Type
#WARNING: INIT ENVIROMENT WIPES DATABASE SCHEMA. ALL DATABASE DATA WILL BE LOST
ENVIROMENT=INIT||DEV||PROD

#Process Name
#This is the name given to the process within the logs
PNAME=SERVER

#Log file
#This is the path to the log file to be used by the api server
LOGFILE=lilypad.log

#Lilypad Database URL
#This is the URL of the postgres database to access and follows typical postgres URL standards
DATABASE_URL=postgresql://[$USER]:[$PASSWORD]@[$IP]:[$PORT]/[$DATABASE_NAME]?schema=public

# Optional — used by docker-compose.yml (defaults: lilypad / lilypad / lilypad)
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# POSTGRES_PORT=5432
# API_PORT=3000

# Better Auth — required when NODE_ENV=production (e.g. Docker). Use a long random secret in production.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000

# Integration tests (`bun test`) use DATABASE_URL above — Prisma must reach the same DB schema as the app.
# With Docker Compose (all-in-one image), Postgres is published on the host; use the app DB name, e.g.:
# DATABASE_URL=postgresql://lilypad:lilypad@127.0.0.1:5432/lilypad?schema=public
# Start the stack first: docker compose up
