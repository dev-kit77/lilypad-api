#Enviroment Type
#WARNING: INIT ENVIROMENT WIPES DATABASE SCHEMA. ALL DATABASE DATA WILL BE LOST
ENVIROMENT=INIT||DEV||PROD

#Lilypad Database URL
#This is the URL of the postgres database to access and follows typical postgres URL standards
DATABASE_URL=postgresql://[$USER]:[$PASSWORD]@[$IP]:[$PORT]/[$DATABASE_NAME]?schema=public
