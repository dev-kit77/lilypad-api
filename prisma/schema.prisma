generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// AUTHENTICATION MODELS START

model User {
  id                    String         @id
  ///User associated username, despite being named "name"
  name                  String         @unique
  email                 String
  emailVerified         Boolean        @default(false)
  image                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  role                  String?
  banned                Boolean?       @default(false)
  banReason             String?
  banExpires            DateTime?
  sessions              Session[]
  accounts              Account[]
  posts                 Post[]
  ///Array of posts a user has upvoted
  upvotes               Post[]         @relation("upvotes")
  ///Profile data object to store public display data
  profile               UserProfile?
  ///Settings data object to store private user settings
  settings              UserSettings?
  ///Array of report objects made against other users
  reports               Report[]       @relation("reportee")
  ///Array of report ojects made against the User
  userReports           Report[]       @relation("reported")

  @@unique([email])
  @@map("user")
}

model Session {
  id                    String   @id
  expiresAt             DateTime
  token                 String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  ipAddress             String?
  userAgent             String?
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy        String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id                    String   @id
  identifier            String
  value                 String
  expiresAt             DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// AUTHENTICATION MODELS END

///User profile model. Stores user vanity data
model UserProfile {
  ///User ID stored as a CUID (Collision Resistant Universally Unique Identifier)
  userID String @unique
  ///User object associated with this profile
  user   User   @relation(fields: [userID], references: [id], onDelete: Cascade)
  ///Users display Name
  name   String
  ///User profile biography
  bio    String
  ///User current status
  status String

  @@map("user_profile")
}

///User settings model. Stores user settings
model UserSettings {
  ///User ID stored as a CUID (Collision Resistant Universally Unique Identifier)
  userID    String   @unique
  ///User object associated with these settings
  user      User     @relation(fields: [userID], references: [id], onDelete: Cascade)
  ///Access flag for setting the date from which the user is allowed access for implementing ban times
  access    DateTime @default(now())
  ///Privilege flag for staff/admin access
  privilege Boolean  @default(false)
  ///Dark flag for dark mode preference
  dark      Boolean  @default(false)
  ///Anonymous flag for anonymous user accounts
  anon      Boolean  @default(false)

  @@map("user_settings")
}

///Post model. Stores post data.
model Post {
  ///Post ID stored as a CUID (Collision Resistant Universally Unique Identifier)
  CUID         String   @id @default(cuid())
  ///User ID stored as a CUID (Collision Resistant Universally Unique Identifier)
  userID       String
  ///User object associated with this post
  user         User     @relation(fields: [userID], references: [id], onDelete: Cascade)
  ///Post textual content
  content      String
  ///Location ID stored as a CUID (Collision Resistant Universally Unique Identifier)
  locationID   String
  ///Location object associated with this post
  location     Location @relation(fields: [locationID], references: [CUID])
  ///Post creation time
  time         DateTime @default(now())
  ///Time of last action
  updated      DateTime @default(now())
  ///Array of users who have upvoted this post
  upvotes      User[]   @relation("upvotes")
  ///Post ID of the Post this Post is replying to
  replyingToID String?
  ///Post object that this Post is replying to
  replyingTo   Post?    @relation("replyingTo", fields: [replyingToID], references: [CUID])
  ///Array of replies to this post
  postReplies  Post[]   @relation("replyingTo")
  ///Reports associated with this Post
  reports      Report[]

  @@map("post")
}

///Model for storing post locations as PostGIS geography points
model Location {
  ///Location ID stored as a CUID (Collision Resistant Universally Unique Identifier)
  CUID  String                          @id @default(cuid())
  ///PostGIS geography point (lon, lat in WGS-84). Written via raw SQL — Prisma cannot set Unsupported types.
  geog  Unsupported("geography(Point, 4326)")
  ///Posts attached to this location
  posts Post[]

  @@map("location")
}

///Report model. Stores report data.
model Report {
  ///Report ID stored as a CUID (Collision Resistant Universally Unique Identifier)
  CUID           String   @id @default(cuid())
  ///User ID of the reporting user stored as a CUID (Collision Resistant Universally Unique Identifier)
  userID         String
  ///User object associated with the reporting user
  user           User     @relation("reportee", fields: [userID], references: [id], onDelete: Cascade)
  ///Reason given for the report
  reason         String
  ///Content of the Report
  content        String
  ///Report creation time
  time           DateTime @default(now())
  ///Report resolution flag
  resolved       Boolean  @default(false)
  ///Description of the action taken based on the Report
  action         String?
  ///User ID of the reported user stored as a CUID (Collision Resistant Universally Unique Identifier)
  reportedUserID String?
  ///User object associated with the reported user
  reportedUser   User?    @relation("reported", fields: [reportedUserID], references: [id])
  ///Post ID of the reported post stored as a CUID (Collision Resistant Universally Unique Identifier)
  reportedPostID String?
  ///Post object associated with the reported post
  reportedPost   Post?    @relation(fields: [reportedPostID], references: [CUID])

  @@map("report")
}
