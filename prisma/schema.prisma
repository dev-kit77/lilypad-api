generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// AUTHENTICATION MODELS START

model User {
  id                    String         @id
  name                  String         @unique
  email                 String
  emailVerified         Boolean        @default(false)
  image                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  role                  String?
  banned                Boolean?       @default(false)
  banReason             String?
  banExpires            DateTime?
  sessions              Session[]
  accounts              Account[]
  posts                 Post[]
  upvotes               Post[]         @relation("upvotes")
  profile               UserProfile?
  settings              UserSettings?
  reports               Report[]       @relation("reportee")
  userReports           Report[]       @relation("reported")

  @@unique([email])
  @@map("user")
}

model Session {
  id                    String   @id
  expiresAt             DateTime
  token                 String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  ipAddress             String?
  userAgent             String?
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy        String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id                    String   @id
  identifier            String
  value                 String
  expiresAt             DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// AUTHENTICATION MODELS END

///User profile model. Stores user vanity data
model UserProfile {
  userID String @unique
  user   User   @relation(fields: [userID], references: [id], onDelete: Cascade)
  name   String
  bio    String
  status String

  @@map("user_profile")
}

///User settings model. Stores user settings
model UserSettings {
  userID    String   @unique
  user      User     @relation(fields: [userID], references: [id], onDelete: Cascade)
  access    DateTime @default(now())
  privilege Boolean  @default(false)
  dark      Boolean  @default(false)
  anon      Boolean  @default(false)

  @@map("user_settings")
}

///Post model. Stores post data.
model Post {
  CUID         String   @id @default(cuid())
  userID       String
  user         User     @relation(fields: [userID], references: [id], onDelete: Cascade)
  content      String
  locationID   String
  location     Location @relation(fields: [locationID], references: [CUID])
  time         DateTime @default(now())
  updated      DateTime @default(now())
  upvotes      User[]   @relation("upvotes")
  replyingToID String?
  replyingTo   Post?    @relation("replyingTo", fields: [replyingToID], references: [CUID])
  postReplies  Post[]   @relation("replyingTo")
  reports      Report[]

  @@map("post")
}

///Model for location tree storage
model Location {
  ///Location ID stored as a CUID (Collision Resistant Universally Unique Identifier)
  CUID      String     @id @default(cuid()) 
  ///Latitude of the location
  lat       Float
  ///Longitude of the location
  long      Float
  ///Parent location ID of this location
  ParentID  String?    
  ///Parent location of this location
  Parent    Location?  @relation("parent", fields: [ParentID], references: [CUID])
  ///Distance to parent object
  distance  Float?
  ///Radius covered by the location in the tree
  radius    Float?
  ///List of posts associated with this location
  posts     Post[]
  ///List of child locations associated with this location
  locations Location[] @relation("parent")

  @@map("location")
}

///Report model. Stores report data.
model Report {
  CUID           String   @id @default(cuid())
  userID         String
  user           User     @relation("reportee", fields: [userID], references: [id], onDelete: Cascade)
  reason         String
  content        String
  time           DateTime @default(now())
  resolved       Boolean  @default(false)
  action         String?
  reportedUserID String?
  reportedUser   User?    @relation("reported", fields: [reportedUserID], references: [id])
  reportedPostID String?
  reportedPost   Post?    @relation(fields: [reportedPostID], references: [CUID])

  @@map("report")
}
