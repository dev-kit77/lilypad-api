// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

///User Model. Stores core userdata.
model User {
  CUID        String        @id @default(cuid())
  email       String        @unique
  username    String        @unique
  token       String        @unique
  hash        String        @unique
  posts       Post[]
  profile     UserProfile?
  settings    UserSettings?
  reports     Report[]      @relation("reportee")
  userReports Report[]      @relation("reported")
}

///User profile model. Stores user vanity data
model UserProfile {
  userID String @unique
  user   User   @relation(fields: [userID], references: [CUID])
  name   String
  bio    String
  status String
}

///User settings model. Stores user settings
model UserSettings {
  userID    String  @unique
  user      User    @relation(fields: [userID], references: [CUID])
  active    Int     @default(0)
  privilege Boolean @default(false)
  dark      Boolean @default(false)
  anon      Boolean @default(false)
}

///Post model. Stores post data.
model Post {
  CUID         String   @id @default(cuid())
  userID       String
  user         User     @relation(fields: [userID], references: [CUID])
  content      String
  lat          Decimal
  long         Decimal
  time         DateTime @default(now())
  reports      Report[]
  replyingToID String?
  replyingTo   Post?    @relation("replyingTo", fields: [replyingToID], references: [CUID])
  postReplies  Post[]   @relation("replyingTo")
}

///Report model. Stores report data.
model Report {
  CUID           String   @id @default(cuid())
  userID         String
  user           User     @relation("reportee", fields: [userID], references: [CUID])
  reason         String
  content        String
  time           DateTime @default(now())
  resolved       Boolean  @default(false)
  action         String?
  reportedUserID String?
  reportedUser   User?    @relation("reported", fields: [reportedUserID], references: [CUID])
  reportedPostID String?
  reportedPost   Post?    @relation(fields: [reportedPostID], references: [CUID])
}
